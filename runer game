function obstacleCollision(){
    for(let i=obstacles.length-1;i>=0;i--){
        const o=obstacles[i];
        if(Math.abs(o.position.z-player.position.z)<2.4 && Math.abs(o.position.x-player.position.x)<1.65 && !o.userData.hit){
            let safe=false;
            if(o.userData.type==="hurdle") safe=jumping || player.position.y>1.65;
            if(o.userData.type==="lowbar") safe=sliding;
            if(o.userData.type==="crate") safe=jumping || player.position.y>1.7;
            if(!safe){
                o.userData.hit=true;
                if(shield){
                    shield=false; activePower="NONE"; powerTime=0; updatePowerHUD();
                    beep(120,.2,"sawtooth");
                }else{
                    loseLife();
                }
                scene.remove(o); obstacles.splice(i,1); continue;
            }
        }
        if(o.position.z>player.position.z+30){scene.remove(o);obstacles.splice(i,1);}
    }
}

function giftCollision(){
    for(let i=gifts.length-1;i>=0;i--){
        const g=gifts[i];
        g.rotation.y+=.06; g.rotation.z=Math.sin(performance.now()*.004+g.position.z)*.08;
        g.position.y=.18+Math.sin(performance.now()*.006+g.position.z)*.18;
        if(distanceXZ(player,g)<1.8 && Math.abs(player.position.y-g.position.y)<2){
            giftCount++; score+=250; coinCount+=2;
            beep(1200,.12,"triangle");
            if(giftCount%5===0){ rewardCount++; score+=1000; coinCount+=10; beep(1600,.25,"square"); }
            scene.remove(g); gifts.splice(i,1);
        }else if(g.position.z>player.position.z+30){scene.remove(g);gifts.splice(i,1);}
    }
}

