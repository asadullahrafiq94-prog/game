<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>HD 3D Endless Runner V2</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

body{
    overflow:hidden;
    background:#02050b;
    font-family:Arial,sans-serif;
    user-select:none;
}

canvas{
    display:block;
}

/* ================= HUD ================= */

#hud{
    position:fixed;
    top:15px;
    left:18px;
    z-index:20;
    color:white;
    font-size:17px;
    font-weight:bold;
    line-height:1.7;
    text-shadow:0 2px 8px #000;
}

#hud span{
    color:#ffd83d;
}

#lives{
    color:#ff4b61 !important;
    letter-spacing:3px;
}

#power{
    color:#63d9ff !important;
}

/* ================= TOP BUTTONS ================= */

#topButtons{
    position:fixed;
    top:15px;
    right:15px;
    z-index:30;
    display:flex;
    gap:8px;
}

.smallBtn{
    width:48px;
    height:42px;
    border-radius:12px;
    border:1px solid rgba(255, 255, 255, 0.2);
    background:rgba(5,15,30,.65);
    color:white;
    font-size:20px;
    cursor:pointer;
    backdrop-filter:blur(10px);
}

/* ================= MENU ================= */

.screen{
    position:fixed;
    inset:0;
    z-index:100;
    display:flex;
    align-items:center;
    justify-content:center;
    background:
        radial-gradient(
            circle at center,
            rgba(0,130,255,.15),
            rgba(0,0,0,.88)
        );
    backdrop-filter:blur(7px);
}

.panel{
    width:min(92%,480px);
    padding:38px 30px;
    text-align:center;
    color:white;
    border-radius:28px;
    background:
        linear-gradient(
            145deg,
            rgba(17,30,58,.96),
            rgba(3,7,18,.97)
        );
    border:1px solid rgba(255,255,255,.16);
    box-shadow:
        0 0 80px rgba(0,130,255,.2),
        inset 0 0 30px rgba(255,255,255,.03);
}

.logo{
    font-size:45px;
    font-weight:900;
    letter-spacing:2px;
    margin-bottom:5px;
    background:linear-gradient(
        90deg,
        #35cfff,
        #ffffff,
        #5f8cff
    );
    -webkit-background-clip:text;
    color:transparent;
    text-transform:uppercase;
    text-shadow:0 0 18px rgba(53,207,255,.35);
}

.subtitle{
    color:#9caecc;
    margin-bottom:28px;
}

.mainBtn{
    width:100%;
    padding:15px;
    margin:7px 0;
    border:0;
    border-radius:14px;
    color:white;
    font-size:17px;
    font-weight:bold;
    cursor:pointer;
    background:linear-gradient(
        135deg,
        #008cff,
        #5548ff
    );
    box-shadow:0 8px 25px rgba(0,100,255,.25);
}

.mainBtn:hover{
    filter:brightness(1.15);
    transform:translateY(-1px);
}

#pauseScreen,
#gameOver{
    display:none;
}
/* ================= CHARACTER SELECT ================= */

.characterGrid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:12px;
    margin:18px 0 10px;
}

.characterCard{
    padding:14px 10px;
    border-radius:16px;
    border:1px solid rgba(255,255,255,.14);
    background:rgba(255,255,255,.045);
    color:white;
    cursor:pointer;
    transition:.18s ease;
}

.characterCard:hover{
    transform:translateY(-2px);
    background:rgba(0,140,255,.12);
}

.characterCard.selected{
    border-color:#35cfff;
    box-shadow:0 0 18px rgba(53,207,255,.28);
    background:rgba(0,140,255,.15);
}

.charIcon{
    font-size:34px;
    display:block;
    margin-bottom:5px;
}

.charName{
    font-weight:800;
    font-size:15px;
}

.charInfo{
    color:#91a2bb;
    font-size:11px;
    margin-top:4px;
    line-height:1.4;
}

.selectedText{
    color:#63d9ff;
    font-weight:bold;
    margin:8px 0 14px;
}

@media(max-width:650px){
    .characterGrid{grid-template-columns:repeat(2,1fr);}
}


.stats{
    display:flex;
    justify-content:space-around;
    margin:20px 0;
    color:#b8c6dc;
}

.stat strong{
    display:block;
    color:#ffd83d;
    font-size:23px;
}

/* ================= CONTROLS ================= */

#mobileControls{
    position:fixed;
    left:0;
    right:0;
    bottom:20px;
    z-index:40;
    display:flex;
    justify-content:center;
    gap:10px;
    pointer-events:none;
}

.control{
    pointer-events:auto;
    width:60px;
    height:60px;
    border-radius:18px;
    border:1px solid rgba(255,255,255,.2);
    background:rgba(5,15,30,.65);
    color:white;
    font-size:24px;
    backdrop-filter:blur(10px);
}

.control:active{
    transform:scale(.9);
    background:#087cff;
}

#hint{
    position:fixed;
    bottom:15px;
    right:15px;
    color:rgba(255,255,255,.6);
    z-index:20;
    font-size:12px;
}

@media(max-width:650px){
    #hint{
        display:none;
    }

    #hud{
        font-size:14px;
    }

    .logo{
        font-size:35px;
    }
}
</style>
</head>

<body>

<!-- ================= HUD ================= -->

<div id="hud">
    SCORE: <span id="score">0</span><br>
    COINS: <span id="coins">0</span><br>
    LIVES: <span id="lives">♥ ♥ ♥</span><br>
    SPEED: <span id="speed">60</span><br>
    GIFTS: <span id="gifts">0</span><br>
    REWARDS: <span id="rewards">0</span><br>
    POWER: <span id="power">NONE</span>
</div>

<!-- ================= TOP BUTTONS ================= -->

<div id="topButtons">
    <button class="smallBtn" id="pauseBtn">Ⅱ</button>
    <button class="smallBtn" id="soundBtn">🔊</button>
</div>

<!-- ================= MENU ================= -->

<div id="menu" class="screen">

    <div class="panel">

        <div class="logo" aria-label="Asadullah Rafiq Runner">ASADULLAH RAFIQ</div>

        <div class="subtitle">
            HD 3D Endless Adventure • Official Game
        </div>

        <div class="stats">
            <div class="stat">
                <strong>3D</strong>
                World
            </div>

            <div class="stat">
                <strong>∞</strong>
                Run
            </div>

            <div class="stat">
                <strong>HD</strong>
                Graphics
            </div>
        </div>

        <button class="mainBtn" id="startBtn">
            ▶ START GAME
        </button>

        <button class="mainBtn" id="instructionsBtn">
            🎮 CONTROLS
        </button>
        <button class="mainBtn" id="characterBtn">
            🧑 CHARACTER
        </button>

    </div>

</div>


<!-- ================= CHARACTER SELECT ================= -->

<div id="characterSelect" class="screen" style="display:none">

    <div class="panel">

        <div class="logo" style="font-size:32px">CHARACTERS</div>

        <div class="subtitle">
            Choose your runner
        </div>

        <div id="selectedCharacterText" class="selectedText">
            Selected: Classic Runner
        </div>

        <div class="characterGrid">

            <div class="characterCard selected" data-character="classic">
                <span class="charIcon">🏃</span>
                <div class="charName">Classic</div>
                <div class="charInfo">Balanced runner</div>
            </div>

            <div class="characterCard" data-character="ninja">
                <span class="charIcon">🥷</span>
                <div class="charName">Ninja</div>
                <div class="charInfo">Fast + high jump</div>
            </div>

            <div class="characterCard" data-character="robot">
                <span class="charIcon">🤖</span>
                <div class="charName">Robot</div>
                <div class="charInfo">Strong futuristic look</div>
            </div>

            <div class="characterCard" data-character="space">
                <span class="charIcon">🚀</span>
                <div class="charName">Space</div>
                <div class="charInfo">High-tech runner</div>
            </div>

            <div class="characterCard" data-character="neon">
                <span class="charIcon">⚡</span>
                <div class="charName">Neon</div>
                <div class="charInfo">Electric style</div>
            </div>

            <div class="characterCard" data-character="gold">
                <span class="charIcon">👑</span>
                <div class="charName">Gold</div>
                <div class="charInfo">Premium golden style</div>
            </div>

        </div>

        <button class="mainBtn" id="characterBackBtn">
            BACK
        </button>

    </div>

</div>


<!-- ================= CONTROLS INFO ================= -->

<div id="instructions" class="screen" style="display:none">

    <div class="panel">

        <div class="logo" style="font-size:32px">
            CONTROLS
        </div>

        <p style="line-height:2;color:#b8c6dc">
            ← / A = Move Left<br>
            → / D = Move Right<br>
            ↑ / W / SPACE = Jump<br>
            ↓ / S = Slide<br>
            P = Pause
        </p>

        <button class="mainBtn" id="backBtn">
            BACK
        </button>

    </div>

</div>


<!-- ================= PAUSE ================= -->

<div id="pauseScreen" class="screen">

    <div class="panel">

        <div class="logo">PAUSED</div>

        <p style="color:#aebbd0;margin:20px">
            Your run is paused.
        </p>

        <button class="mainBtn" id="resumeBtn">
            ▶ RESUME
        </button>

        <button class="mainBtn" id="menuBtn">
            ⌂ MAIN MENU
        </button>

    </div>

</div>


<!-- ================= GAME OVER ================= -->

<div id="gameOver" class="screen">

    <div class="panel">

        <div class="logo">GAME OVER</div>

        <div class="stats">

            <div class="stat">
                <strong id="finalScore">0</strong>
                SCORE
            </div>

            <div class="stat">
                <strong id="finalCoins">0</strong>
                COINS
            </div>

            <div class="stat">
                <strong id="finalGifts">0</strong>
                GIFTS
            </div>

            <div class="stat">
                <strong id="finalRewards">0</strong>
                REWARDS
            </div>

        </div>

        <button class="mainBtn" id="againBtn">
            🔄 PLAY AGAIN
        </button>

        <button class="mainBtn" id="gameMenuBtn">
            ⌂ MAIN MENU
        </button>

    </div>

</div>


<!-- ================= MOBILE ================= -->

<div id="mobileControls">

    <button class="control" id="leftBtn">◀</button>
    <button class="control" id="jumpBtn">▲</button>
    <button class="control" id="slideBtn">▼</button>
    <button class="control" id="rightBtn">▶</button>

</div>


<div id="hint">
    A/D or ←/→ • W/SPACE/↑ Jump • S/↓ Slide • P Pause
</div>


<script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>

<script>

/* =========================================================
   BASIC SETUP
========================================================= */

const scene = new THREE.Scene();

scene.background = new THREE.Color(0x081426);

scene.fog = new THREE.FogExp2(
    0x081426,
    0.008
);


/* CAMERA */

const camera = new THREE.PerspectiveCamera(
    65,
    innerWidth / innerHeight,
    .1,
    1000
);

camera.position.set(
    0,
    5.4,
    12
);


/* RENDERER */

const renderer = new THREE.WebGLRenderer({
    antialias:true,
    powerPreference:"high-performance"
});

renderer.setSize(
    innerWidth,
    innerHeight
);

renderer.setPixelRatio(
    Math.min(
        window.devicePixelRatio,
        2
    )
);

renderer.shadowMap.enabled = true;

renderer.shadowMap.type =
    THREE.PCFSoftShadowMap;

renderer.outputColorSpace =
    THREE.SRGBColorSpace;

renderer.toneMapping =
    THREE.ACESFilmicToneMapping;

renderer.toneMappingExposure = 1.15;

document.body.appendChild(
    renderer.domElement
);


/* =========================================================
   LIGHTS
========================================================= */

const hemi =
    new THREE.HemisphereLight(
        0x8fd8ff,
        0x11131c,
        2
    );

scene.add(hemi);


const sun =
    new THREE.DirectionalLight(
        0xffffff,
        4
    );

sun.position.set(
    30,
    60,
    20
);

sun.castShadow = true;

sun.shadow.mapSize.width = 2048;
sun.shadow.mapSize.height = 2048;

sun.shadow.camera.left = -80;
sun.shadow.camera.right = 80;
sun.shadow.camera.top = 80;
sun.shadow.camera.bottom = -80;

scene.add(sun);


/* NIGHT LIGHT */

const cityLight =
    new THREE.PointLight(
        0x168cff,
        30,
        100
    );

cityLight.position.set(
    0,
    12,
    -40
);

scene.add(cityLight);


/* =========================================================
   MATERIALS
========================================================= */

const roadMat =
    new THREE.MeshStandardMaterial({
        color:0x151a22,
        roughness:.82,
        metalness:.12
    });


const railMat =
    new THREE.MeshStandardMaterial({
        color:0xbcc5d1,
        roughness:.22,
        metalness:.95
    });


const sleeperMat =
    new THREE.MeshStandardMaterial({
        color:0x3b2921,
        roughness:.9
    });


const metalMat =
    new THREE.MeshStandardMaterial({
        color:0x202936,
        roughness:.3,
        metalness:.9
    });


const coinMat =
    new THREE.MeshStandardMaterial({
        color:0xffd21c,
        emissive:0xff7b00,
        emissiveIntensity:1.5,
        metalness:.85,
        roughness:.16
    });


/* =========================================================
   TRACK
========================================================= */

const track =
    new THREE.Mesh(
        new THREE.BoxGeometry(
            18,
            .4,
            1000
        ),
        roadMat
    );

track.position.set(
    0,
    -.3,
    -450
);

track.receiveShadow = true;

scene.add(track);


/* RAILS */

const railPositions =
    [-6,-2,2,6];

railPositions.forEach(x=>{

    const rail =
        new THREE.Mesh(
            new THREE.BoxGeometry(
                .18,
                .18,
                1000
            ),
            railMat
        );

    rail.position.set(
        x,
        .05,
        -450
    );

    rail.castShadow = true;

    scene.add(rail);
});


/* SLEEPERS */

const sleepers=[];

for(
    let z=10;
    z>-950;
    z-=3
){

    const sleeper =
        new THREE.Mesh(
            new THREE.BoxGeometry(
                16,
                .3,
                .7
            ),
            sleeperMat
        );

    sleeper.position.set(
        0,
        -.05,
        z
    );

    sleeper.receiveShadow=true;

    scene.add(sleeper);

    sleepers.push(sleeper);
}


/* =========================================================
   PLAYER
========================================================= */

const player =
    new THREE.Group();

player.position.set(
    0,
    1.1,
    0
);

scene.add(player);


/* BODY */

const bodyMat =
    new THREE.MeshStandardMaterial({
        color:0x137bff,
        roughness:.4,
        metalness:.2
    });

const body =
    new THREE.Mesh(
        new THREE.BoxGeometry(
            1.15,
            1.55,
            .7
        ),
        bodyMat
    );

body.position.y=.2;
body.castShadow=true;

player.add(body);


/* HEAD */

const head =
    new THREE.Mesh(
        new THREE.SphereGeometry(
            .48,
            32,
            32
        ),
        new THREE.MeshStandardMaterial({
            color:0xd99a72,
            roughness:.7
        })
    );

head.position.y=1.25;

head.castShadow=true;

player.add(head);


/* HAIR */

const hair =
    new THREE.Mesh(
        new THREE.SphereGeometry(
            .49,
            32,
            20
        ),
        new THREE.MeshStandardMaterial({
            color:0x121212,
            roughness:.6
        })
    );

hair.scale.y=.55;

hair.position.y=1.55;

player.add(hair);


/* BACKPACK */

const backpack =
    new THREE.Mesh(
        new THREE.BoxGeometry(
            .9,
            1.15,
            .35
        ),
        new THREE.MeshStandardMaterial({
            color:0x161d29,
            roughness:.5
        })
    );

backpack.position.set(
    0,
    .35,
    .5
);

player.add(backpack);


/* LIMBS */

const skinMat =
    new THREE.MeshStandardMaterial({
        color:0xd99a72,
        roughness:.7
    });

const clothesMat =
    new THREE.MeshStandardMaterial({
        color:0x111927,
        roughness:.6
    });


const leftArm =
    new THREE.Mesh(
        new THREE.CapsuleGeometry(
            .16,
            .75,
            8,
            16
        ),
        skinMat
    );

const rightArm =
    leftArm.clone();


leftArm.position.set(
    -.75,
    .25,
    0
);

rightArm.position.set(
    .75,
    .25,
    0
);

player.add(leftArm);
player.add(rightArm);


const leftLeg =
    new THREE.Mesh(
        new THREE.CapsuleGeometry(
            .19,
            .8,
            8,
            16
        ),
        clothesMat
    );

const rightLeg =
    leftLeg.clone();


leftLeg.position.set(
    -.32,
    -.8,
    0
);

rightLeg.position.set(
    .32,
    -.8,
    0
);

player.add(leftLeg);
player.add(rightLeg);


/* SHOES */

const shoeMat =
    new THREE.MeshStandardMaterial({
        color:0xf4f7ff,
        roughness:.3
    });


const leftShoe =
    new THREE.Mesh(
        new THREE.BoxGeometry(
            .45,
            .22,
            .8
        ),
        shoeMat
    );

const rightShoe =
    leftShoe.clone();


leftShoe.position.set(
    -.32,
    -1.25,
    -.18
);

rightShoe.position.set(
    .32,
    -1.25,
    -.18
);

player.add(leftShoe);
player.add(rightShoe);


/* PLAYER SHADOW */

const playerShadow =
    new THREE.Mesh(
        new THREE.CircleGeometry(
            .85,
            32
        ),
        new THREE.MeshBasicMaterial({
            color:0x000000,
            transparent:true,
            opacity:.35
        })
    );

playerShadow.rotation.x =
    -Math.PI/2;

playerShadow.position.y =
    -1.35;

player.add(playerShadow);


/* =========================================================
   CHARACTER TYPES / OPTIONAL SKINS
========================================================= */

const characterStyles = {
    classic:{
        name:"Classic Runner",
        body:0x137bff,
        clothes:0x111927,
        skin:0xd99a72,
        shoe:0xf4f7ff,
        speed:1,
        jump:1,
        accessory:"none"
    },
    ninja:{
        name:"Ninja",
        body:0x191b24,
        clothes:0x080a12,
        skin:0xc88462,
        shoe:0x15151c,
        speed:1.08,
        jump:1.12,
        accessory:"ninja"
    },
    robot:{
        name:"Robot",
        body:0x68778c,
        clothes:0x303b4d,
        skin:0xb7c5d8,
        shoe:0x9daabd,
        speed:.98,
        jump:.98,
        accessory:"robot"
    },
    space:{
        name:"Space Runner",
        body:0xe9eef7,
        clothes:0x27314b,
        skin:0xd99a72,
        shoe:0x77cfff,
        speed:1.03,
        jump:1.08,
        accessory:"space"
    },
    neon:{
        name:"Neon Runner",
        body:0x5b19ff,
        clothes:0x10142a,
        skin:0xd99a72,
        shoe:0x35f6ff,
        speed:1.06,
        jump:1.03,
        accessory:"neon"
    },
    gold:{
        name:"Golden Runner",
        body:0xffb300,
        clothes:0x3a2100,
        skin:0xe0a070,
        shoe:0xffdf63,
        speed:1.02,
        jump:1.02,
        accessory:"gold"
    }
};

let selectedCharacter = "classic";
const characterAccessory = new THREE.Group();
player.add(characterAccessory);

function makeAccessoryMaterial(color, emissive=0x000000){
    return new THREE.MeshStandardMaterial({
        color,
        emissive,
        emissiveIntensity: emissive ? 1.4 : 0,
        metalness:.7,
        roughness:.22
    });
}

function clearCharacterAccessory(){
    while(characterAccessory.children.length){
        characterAccessory.remove(characterAccessory.children[0]);
    }
}

function applyCharacterStyle(type){
    const style = characterStyles[type] || characterStyles.classic;
    selectedCharacter = type;
    characterSpeedMultiplier = style.speed;
    characterJumpMultiplier = style.jump;

    body.material.color.setHex(style.body);
    clothesMat.color.setHex(style.clothes);
    skinMat.color.setHex(style.skin);
    shoeMat.color.setHex(style.shoe);

    clearCharacterAccessory();

    if(style.accessory === "ninja"){
        const mask = new THREE.Mesh(
            new THREE.BoxGeometry(.92,.32,.12),
            makeAccessoryMaterial(0x05060a)
        );
        mask.position.set(0,1.25,-.43);
        player.add(mask);
        characterAccessory.add(mask);

        const band = new THREE.Mesh(
            new THREE.BoxGeometry(1.18,.09,.1),
            makeAccessoryMaterial(0xb50028)
        );
        band.position.set(0,1.63,.02);
        characterAccessory.add(band);
    }

    if(style.accessory === "robot"){
        const antenna = new THREE.Mesh(
            new THREE.CylinderGeometry(.045,.045,.45,10),
            makeAccessoryMaterial(0x93a9c4,0x164cff)
        );
        antenna.position.set(0,2.05,0);
        characterAccessory.add(antenna);

        const eye = new THREE.Mesh(
            new THREE.BoxGeometry(.5,.13,.08),
            new THREE.MeshBasicMaterial({color:0x32e8ff})
        );
        eye.position.set(0,1.28,-.45);
        characterAccessory.add(eye);
    }

    if(style.accessory === "space"){
        const visor = new THREE.Mesh(
            new THREE.SphereGeometry(.50,24,16),
            new THREE.MeshStandardMaterial({
                color:0x18283c,
                emissive:0x147bff,
                emissiveIntensity:.65,
                transparent:true,
                opacity:.72,
                metalness:.8,
                roughness:.1
            })
        );
        visor.scale.set(1,.62,.35);
        visor.position.set(0,1.30,-.36);
        characterAccessory.add(visor);

        const antenna = new THREE.Mesh(
            new THREE.CylinderGeometry(.035,.035,.32,10),
            makeAccessoryMaterial(0x77cfff,0x147bff)
        );
        antenna.position.set(.32,1.86,0);
        characterAccessory.add(antenna);
    }

    if(style.accessory === "neon"){
        const ring = new THREE.Mesh(
            new THREE.TorusGeometry(.72,.055,12,32),
            makeAccessoryMaterial(0x35f6ff,0x35f6ff)
        );
        ring.rotation.x=Math.PI/2;
