/* =========================================================
   PLAYER ANIMATION
========================================================= */

function animatePlayer(delta){

    runTime+=
        delta*
        (18+
        speed*5);


    if(
        !jumping &&
        !sliding
    ){

        const swing=
            Math.sin(runTime)*.72;


        leftArm.rotation.x=
            swing;

        rightArm.rotation.x=
            -swing;


        leftLeg.rotation.x=
            -swing;

        rightLeg.rotation.x=
            swing;


        body.rotation.z=
            Math.sin(
                runTime*2
            )*.025;


        player.position.y=
            1.1+
            Math.abs(
                Math.sin(runTime)
            )*.055;
    }


    if(jumping){

        player.position.y+=
            jumpVelocity;

        jumpVelocity-=.018;


        if(
            player.position.y<=1.1
        ){

            player.position.y=1.1;

            jumping=false;

            jumpVelocity=0;
        }
    }


    if(sliding){

        player.scale.y=
            THREE.MathUtils.lerp(
                player.scale.y,
                .55,
                .25
            );

    }else{

        player.scale.y=
            THREE.MathUtils.lerp(
                player.scale.y,
                1,
                .25
            );
    }


    /* SHIELD EFFECT */

    if(shield){

        if(
            !player.userData.shield
        ){

            const shieldMesh=
                new THREE.Mesh(
                    new THREE.SphereGeometry(
                        1.7,
                        32,
                        32
                    ),
                    new THREE.MeshBasicMaterial({
                        color:0x25cfff,
                        transparent:true,
                        opacity:.18,
                        wireframe:true
                    })
                );

            player.add(shieldMesh);

            player.userData.shield=
                shieldMesh;
        }

    }else{

        if(
            player.userData.shield
        ){

            player.remove(
                player.userData.shield
            );

            player.userData.shield=null;
        }
    }
}


