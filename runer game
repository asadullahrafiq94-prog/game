            if(
                sleeper.position.z>
                player.position.z+30
            ){

                sleeper.position.z-=950;
            }
        }
    );


    /* POWER UPS */

    powerUps.forEach(
        p=>{

            p.rotation.y+=.05;

            p.rotation.z+=.025;

            p.position.y=
                1.4+
                Math.sin(
                    performance.now()*.005+
                    p.position.z
                )*.18;
        }
    );
}


