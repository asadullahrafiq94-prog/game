   START GAME
========================================================= */

function startGame(){

    initAudio();

    document
        .getElementById("menu")
        .style.display="none";

    running=true;

    paused=false;
}


/* =========================================================
   PAUSE
========================================================= */

function togglePause(){

    if(!running)
        return;


    paused=!paused;


    document
        .getElementById("pauseScreen")
        .style.display=
        paused
        ?
        "flex"
        :
        "none";
}


pauseBtn.onclick=
    togglePause;


resumeBtn.onclick=
    togglePause;


/* =========================================================
   MENU BUTTON
========================================================= */

function goMenu(){

    location.reload();
}


menuBtn.onclick=goMenu;

gameMenuBtn.onclick=goMenu;


/* =========================================================
   MENU EVENTS
========================================================= */

startBtn.onclick=
    startGame;


characterBtn.onclick =
    ()=>{
        menu.style.display="none";
        characterSelect.style.display="flex";
    };

document.querySelectorAll(".characterCard").forEach(card=>{
    card.addEventListener("click",()=>{
        const type=card.dataset.character;
        applyCharacterStyle(type);
    });
});

characterBackBtn.onclick =
    ()=>{
        characterSelect.style.display="none";
        menu.style.display="flex";
    };

instructionsBtn.onclick=
    ()=>{

        menu.style.display="none";

        instructions.style.display="flex";
    };


backBtn.onclick=
    ()=>{

        instructions.style.display="none";

        menu.style.display="flex";
    };


againBtn.onclick=
    ()=>{

        location.reload();
    };


/* =========================================================
   SOUND
========================================================= */

soundBtn.onclick=
    ()=>{

        soundOn=!soundOn;

        soundBtn.innerText=
            soundOn
            ?
            "🔊"
            :
            "🔇";

        if(soundOn)
            beep(700,.1);
    };


/* =========================================================
   GAME OVER
========================================================= */

function endGame(){

    running=false;

    paused=false;

    document
        .getElementById("finalScore")
        .innerText=
        Math.floor(score);

    document
        .getElementById("finalCoins")
        .innerText=
        coinCount;

    document.getElementById("finalGifts").innerText=giftCount;
    document.getElementById("finalRewards").innerText=rewardCount;

    document
        .getElementById("gameOver")
        .style.display="flex";

    beep(
        80,
        .5,
        "sawtooth"
    );
}


/* =========================================================
   MAIN GAME LOOP
========================================================= */

function animate(){

    requestAnimationFrame(
        animate
    );


    const now=
        performance.now();


    const delta=
        Math.min(
            (now-lastTime)/1000,
            .05
        );


    lastTime=now;


    if(
        running &&
        !paused
    ){

        /* FORWARD */

        player.position.z-=
            speed;


        /* LANE */

        player.position.x+=
            (
                lanes[lane]-
                player.position.x
            )*.18;


        /* BOOST */

        let actualSpeed=
            speed;


        if(boost)
            actualSpeed=
                speed*1.8;


        player.position.z-=
            actualSpeed-speed;


        /* SCORE */

        score+=
            actualSpeed*.35;


        /* SPEED INCREASE */

        speed=
            Math.min(
                1.3,
                .45+
                score/35000
            );


        /* SPAWN */

        spawnTimer+=delta;
        coinTimer+=delta;
        powerTimer+=delta;
        obstacleTimer+=delta;
        giftTimer+=delta;


        if(
            spawnTimer>.85
        ){

            spawnTrain();

            spawnTimer=0;
        }


        if(
            coinTimer>1.3
        ){

            spawnCoinLine();

            coinTimer=0;
        }


        if(
            powerTimer>6
        ){

            spawnPower();

            powerTimer=0;
        }

        if(obstacleTimer>1.35){
            spawnObstacle();
            obstacleTimer=0;
        }

        if(giftTimer>7){
            spawnGift();
            giftTimer=0;
        }


        /* POWER TIMER */

        if(
            activePower!=="NONE"
        ){

            powerTime-=delta;

            if(
                powerTime<=0
            ){

                activePower="NONE";

                shield=false;
                magnet=false;
                boost=false;

                powerTime=0;
            }

            updatePowerHUD();
        }


        animatePlayer(delta);

        updateCamera();

        updateWorld();

        updateDayNight(delta);

        trainCollision();

        obstacleCollision();
        giftCollision();

        coinCollision();

        powerCollision();


        /* COIN ANIMATION */

        coins.forEach(
            coin=>{

                coin.rotation.y+=.09;

                coin.rotation.x+=.015;

                coin.position.y+=
                    Math.sin(
                        performance.now()*.005+
                        coin.position.z
                    )*.002;
            }
        );


        /* HUD */

        scoreEl.innerText=
            Math.floor(score);

        coinsEl.innerText=
            coinCount;

        document.getElementById("gifts").innerText=giftCount;
        document.getElementById("rewards").innerText=rewardCount;

        speedEl.innerText=
            Math.round(
                speed*100
            );
    }


    renderer.render(
        scene,
        camera
    );
}


/* =========================================================
   HUD REFERENCES
========================================================= */

const scoreEl=
    document.getElementById(
        "score"
    );

const coinsEl=
    document.getElementById(
        "coins"
    );

const speedEl=
    document.getElementById(
        "speed"
    );


/* =========================================================
   RESIZE
========================================================= */

window.addEventListener(
    "resize",
    ()=>{

        camera.aspect=
            innerWidth/
            innerHeight;

        camera.updateProjectionMatrix();

        renderer.setSize(
            innerWidth,
            innerHeight
        );
    }
);


/* DEFAULT CHARACTER */

applyCharacterStyle("classic");

/* START RENDERING */

animate();

</script>

