/* =========================================================
   COLLISION
========================================================= */

function distanceXZ(
    a,
    b
){

    const dx=
        a.position.x-
        b.position.x;

    const dz=
        a.position.z-
        b.position.z;

    return Math.sqrt(
        dx*dx+
        dz*dz
    );
}


function trainCollision(){

    for(
        let i=trains.length-1;
        i>=0;
        i--
    ){

        const train=
            trains[i];


        if(
            Math.abs(
                train.position.z-
                player.position.z
            )<5.5 &&
            Math.abs(
                train.position.x-
                player.position.x
            )<2
        ){

            if(
                !jumping &&
                !sliding
            ){

                if(shield){

                    shield=false;

                    activePower="NONE";

                    powerTime=0;

                    beep(
                        110,
                        .25,
                        "sawtooth"
                    );

                }else{

                    loseLife();
                }
            }
        }


        if(
            train.position.z>
            player.position.z+40
        ){

            scene.remove(train);

            trains.splice(i,1);
        }
    }
}


/* =========================================================
   COIN COLLISION
========================================================= */

function coinCollision(){

    for(
        let i=coins.length-1;
        i>=0;
        i--
    ){

        const coin=
            coins[i];


        let distance=
            distanceXZ(
                player,
                coin
            );


        if(magnet)
            distance*=.45;


        if(
            distance<1.7 &&
            Math.abs(
                player.position.y-
