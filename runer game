    if(type==="hurdle") matColor=0xff9f1c;
    if(type==="lowbar") matColor=0xe83e8c;
    if(type==="crate") matColor=0x8b5a2b;

    const mat=new THREE.MeshStandardMaterial({color:matColor,roughness:.5,metalness:.2});

    if(type==="lowbar"){
        const pole1=new THREE.Mesh(new THREE.BoxGeometry(.22,2.2,.22),mat);
        const pole2=pole1.clone();
        const bar=new THREE.Mesh(new THREE.BoxGeometry(3.2,.35,.35),mat);
        pole1.position.set(-1.45,1.1,0); pole2.position.set(1.45,1.1,0); bar.position.set(0,2.05,0);
        group.add(pole1,pole2,bar);
    }else{
        const h=type==="crate"?1.35:.85;
        const box=new THREE.Mesh(new THREE.BoxGeometry(2.8,h,.9),mat);
        box.position.y=h/2; box.castShadow=true; group.add(box);
        if(type==="hurdle"){
