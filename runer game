/* =========================================================
   DAY / NIGHT
========================================================= */

function updateDayNight(delta){

    dayTime+=
        delta*.015;


    const cycle=
        (Math.sin(dayTime)+1)/2;


    /* SKY */

    const dayColor=
        new THREE.Color(
            0x75cfff
        );

    const nightColor=
        new THREE.Color(
            0x030713
        );


    scene.background.lerpColors(
        nightColor,
        dayColor,
        cycle
    );


    /* FOG */

    const fogDay=
        new THREE.Color(
            0x75cfff
        );

    const fogNight=
        new THREE.Color(
            0x030713
        );


    scene.fog.color.lerpColors(
        fogNight,
        fogDay,
        cycle
    );


    /* SUN */

    sun.intensity=
        .8+
        cycle*3.2;


    hemi.intensity=
        .6+
        cycle*1.5;


    cityLight.intensity=
        8+
        (1-cycle)*35;
}


